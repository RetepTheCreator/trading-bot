# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
# Sign up free at https://alpaca.markets → click "Paper Trading"
# Then go to: Paper Trading dashboard → API Keys → Generate
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true

# ── Telegram (for phone notifications & remote decisions) ─────────────────────
# See setup guide for how to get these two values (takes ~5 minutes)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Capital & watchlist ───────────────────────────────────────────────────────
STARTING_CAPITAL_CZK=2000
WATCHLIST=SPY,QQQ,AAPL,TSLA,AMD,NVDA
